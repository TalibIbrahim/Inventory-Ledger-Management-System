{
  "name": "inventory-management",
  "private": true,
  "version": "1.0.0",
  "description": "Axiom Stock Ledger",
  "author": "Talib Ibrahim",
  "repository": {
    "type": "git",
    "url": "https://github.com/TalibIbrahim/Inventory-Ledger-Management-System.git"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && electron-builder",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"cross-env NODE_ENV=development vite\" \"electron .\""
  },
  "dependencies": {
    "@seald-io/nedb": "^4.1.2",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.45.0",
    "mongodb": "^7.6.0",
    "mongoose": "^9.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "build": {
    "appId": "com.axiom.stockledger",
    "productName": "Axiom Stock Ledger",
    "publish": ["github"],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "identity": null
    }
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.6",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2"
  }
}
